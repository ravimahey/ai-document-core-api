DATABASE_URL="sqlite:///./data/app.db"

JWT_ALGORITHM=RS256
JWT_PRIVATE_KEY=""
JWT_PUBLIC_KEY=""
JWT_ISSUER="user"
JWT_AUDIENCE="user"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# OTP Configuration
OTP_EXPIRE_MINUTES=5
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_REQUESTS_PER_HOUR=10
OTP_SECRET_KEY="replace-with-a-secure-random-secret-key"

# Email Configuration
EMAIL_PROVIDER="console" # Options: console, smtp, mock
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL="noreply@documentanalysis.ai"
SMTP_USE_TLS=true

# OpenAI / LangChain Chatbot Configuration
OPENAI_API_KEY="" # Your OpenAI API Key (sk-...)
OPENAI_MODEL="gpt-4.1-nano" # e.g. gpt-4.1-nano, gpt-4o-mini
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_OUTPUT_TOKENS=2048
CHAT_MAX_INPUT_CHARACTERS=4000
CHAT_HISTORY_MESSAGE_LIMIT=20
CHAT_REQUEST_TIMEOUT_SECONDS=30.0
CHAT_SYSTEM_PROMPT="You are a helpful, respectful, and concise AI assistant."

# Object Storage Configuration (MinIO / S3 / Local)
OBJECT_STORAGE_PROVIDER="minio" # Options: minio, s3, local
MINIO_ENDPOINT_URL="http://localhost:9000"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET_NAME="documents"
MINIO_REGION="us-east-1"
MINIO_SECURE=false

# AWS S3 (Used when OBJECT_STORAGE_PROVIDER="s3")
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_S3_BUCKET_NAME="documents"

# Celery & Redis Task Broker
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/1"
CELERY_TASK_ALWAYS_EAGER=false

# Document Ingestion & Vector Storage
MAX_UPLOAD_SIZE_BYTES=26214400 # 25 MB
EMBEDDING_MODEL="text-embedding-3-small"
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
FAISS_INDEX_DIR="./data/faiss_indexes"